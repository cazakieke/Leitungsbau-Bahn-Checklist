            <div class="export-section">
                <h2>📤 Datenexport und Bericht</h2>
                <p>Exportieren Sie Ihre Checklisten-Daten in verschiedenen Formaten oder drucken Sie einen vollständigen Bericht.</p>
                
                <div class="separator"></div>

                <h3>Exportoptionen:</h3>
                <div class="export-buttons">
                    <button class="btn-primary" onclick="exportToJSON()">📄 JSON Export</button>
                    <button class="btn-primary" onclick="exportToCSV()">📊 CSV Export</button>
                    <button class="btn-primary" onclick="generatePDF()">📕 PDF-Bericht</button>
                    <button class="btn-secondary" onclick="printReport()">🖨️ Drucken</button>
                </div>

                <div class="separator"></div>

                <h3>Verwaltung:</h3>
                <div class="export-buttons">
                    <button class="btn-secondary" onclick="clearAllData()">🗑️ Alle Daten löschen</button>
                    <button class="btn-secondary" onclick="downloadBackup()">💾 Backup laden</button>
                </div>

                <div id="statusMessage" style="margin-top: 20px;"></div>
            </div>
        </div>
    </div>

    <script>
        // Store for file data
        const fileStore = {};

        // Initialize app
        function initApp() {
            loadFromLocalStorage();
            updateSummary();
        }

        // Tab switching
        function switchTab(tabName) {
            // Hide all tabs
            document.querySelectorAll('.tab-content').forEach(tab => {
                tab.classList.remove('active');
            });
            
            // Remove active class from all buttons
            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.classList.remove('active');
            });
            
            // Show selected tab
            document.getElementById(tabName).classList.add('active');
            
            // Add active class to clicked button
            event.target.classList.add('active');
        }

        // Get geolocation
        function getLocation(itemId) {
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(
                    function(position) {
                        const lat = position.coords.latitude.toFixed(6);
                        const lon = position.coords.longitude.toFixed(6);
                        
                        document.getElementById(itemId + '_lat').textContent = lat;
                        document.getElementById(itemId + '_lon').textContent = lon;
                        document.getElementById(itemId + '_location').style.display = 'block';
                        
                        // Set date and time automatically
                        const now = new Date();
                        document.getElementById(itemId + '_photo_date').valueAsDate = now;
                        document.getElementById(itemId + '_photo_time').value = 
                            now.getHours().toString().padStart(2, '0') + ':' + 
                            now.getMinutes().toString().padStart(2, '0');
                    },
                    function(error) {
                        alert('Fehler beim Abrufen der Position: ' + error.message);
                    }
                );
            } else {
                alert('Geolocation wird von diesem Browser nicht unterstützt.');
            }
        }

        // File handling
        function handleFileSelect(event, itemId) {
            const files = event.target.files;
            if (!fileStore[itemId]) {
                fileStore[itemId] = [];
            }

            for (let file of files) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    fileStore[itemId].push({
                        name: file.name,
                        data: e.target.result
                    });
                    updateFilePreview(itemId);
                };
                reader.readAsDataURL(file);
            }
        }

        function updateFilePreview(itemId) {
            const preview = document.getElementById(itemId + '_preview');
            preview.innerHTML = '';
            
            if (fileStore[itemId]) {
                fileStore[itemId].forEach((file, index) => {
                    const div = document.createElement('div');
                    div.className = 'file-item';
                    
                    if (file.data.startsWith('data:image')) {
                        div.innerHTML = `
                            <img src="${file.data}" alt="Preview">
                            <button type="button" class="file-remove" onclick="removeFile('${itemId}', ${index})">×</button>
                        `;
                    } else {
                        div.innerHTML = `
                            <div style="padding: 10px; text-align: center; word-break: break-all; font-size: 12px;">
                                ${file.name}
                                <button type="button" class="file-remove" onclick="removeFile('${itemId}', ${index})">×</button>
                            </div>
                        `;
                    }
                    preview.appendChild(div);
                });
            }
        }

        function removeFile(itemId, index) {
            fileStore[itemId].splice(index, 1);
            updateFilePreview(itemId);
        }

        // Conditional field visibility
        function updateConditionalFields(itemId) {
            const applicableRadio = document.querySelector(`input[name="${itemId}_applicable"]:checked`);
            const statusRadio = document.querySelector(`input[name="${itemId}_status"]:checked`);
            const contentDiv = document.getElementById(itemId + '_content');
            const actionPlanDiv = document.getElementById(itemId + '_action_plan');

            if (applicableRadio && applicableRadio.value === 'yes') {
                contentDiv.classList.add('show');
            } else {
                contentDiv.classList.remove('show');
            }

            if (statusRadio && statusRadio.value === 'non_compliant') {
                actionPlanDiv.classList.add('show');
            } else {
                actionPlanDiv.classList.remove('show');
            }
        }

        // E31 Update functions
        function updateE31_01() { updateConditionalFields('e31_01'); }
        function updateE31_02() { updateConditionalFields('e31_02'); }
        function updateE31_03() { updateConditionalFields('e31_03'); }
        function updateE31_04() { updateConditionalFields('e31_04'); }

        // E32 Update functions
        function updateE32_01() { updateConditionalFields('e32_01'); }
        function updateE32_02() { updateConditionalFields('e32_02'); }
        function updateE32_03() { updateConditionalFields('e32_03'); }
        function updateE32_04() { updateConditionalFields('e32_04'); }

        // E33 Update functions
        function updateE33_01() { updateConditionalFields('e33_01'); }
        function updateE33_02() { updateConditionalFields('e33_02'); }
        function updateE33_03() { updateConditionalFields('e33_03'); }
        function updateE33_04() { updateConditionalFields('e33_04'); }

        // E34 Update functions
        function updateE34_01() { updateConditionalFields('e34_01'); }
        function updateE34_02() { updateConditionalFields('e34_02'); }
        function updateE34_03() { updateConditionalFields('e34_03'); }
        function updateE34_04() { updateConditionalFields('e34_04'); }

        // Save functions
        function saveE31() {
            saveModule('e31');
            showMessage('✅ E31 Daten gespeichert!', 'success');
        }

        function saveE32() {
            saveModule('e32');
            showMessage('✅ E32 Daten gespeichert!', 'success');
        }

        function saveE33() {
            saveModule('e33');
            showMessage('✅ E33 Daten gespeichert!', 'success');
        }

        function saveE34() {
            saveModule('e34');
            showMessage('✅ E34 Daten gespeichert!', 'success');
        }

        function saveModule(moduleId) {
            const moduleData = {
                projectName: document.getElementById('projectName').value,
                projectArea: document.getElementById('projectArea').value,
                moduleId: moduleId,
                timestamp: new Date().toISOString(),
                items: []
            };

            for (let i = 1; i <= 4; i++) {
                const itemId = moduleId + '_0' + i;
                const applicable = document.querySelector(`input[name="${itemId}_applicable"]:checked`)?.value;
                const status = document.querySelector(`input[name="${itemId}_status"]:checked`)?.value;

                if (applicable) {
                    moduleData.items.push({
                        itemId: itemId,
                        applicable: applicable,
                        status: status,
                        action: document.getElementById(itemId + '_action')?.value || '',
                        responsible: document.getElementById(itemId + '_responsible')?.value || '',
                        deadline: document.getElementById(itemId + '_deadline')?.value || '',
                        checkedDate: document.getElementById(itemId + '_checked_date')?.value || '',
                        photoDate: document.getElementById(itemId + '_photo_date')?.value || '',
                        photoTime: document.getElementById(itemId + '_photo_time')?.value || '',
                        latitude: document.getElementById(itemId + '_lat')?.textContent || '',
                        longitude: document.getElementById(itemId + '_lon')?.textContent || '',
                        notes: document.getElementById(itemId + '_notes')?.value || '',
                        files: fileStore[itemId] || []
                    });
                }
            }

            // Save to localStorage
            const allData = JSON.parse(localStorage.getItem('checklistData')) || {};
            allData[moduleId] = moduleData;
            localStorage.setItem('checklistData', JSON.stringify(allData));

            updateSummary();
        }

        function resetE31() {
            if (confirm('Möchten Sie alle E31-Daten wirklich löschen?')) {
                document.querySelectorAll('input[name^="e31_"], textarea[id^="e31_"]').forEach(el => {
                    if (el.type === 'radio' || el.type === 'checkbox') {
                        el.checked = false;
                    } else if (el.type === 'date' || el.type === 'time' || el.tagName === 'TEXTAREA') {
                        el.value = '';
                    }
                });
                fileStore['e31_01'] = [];
                fileStore['e31_02'] = [];
                fileStore['e31_03'] = [];
                fileStore['e31_04'] = [];
                document.querySelectorAll('[id$="_preview"]').forEach(div => {
                    if (div.id.startsWith('e31')) div.innerHTML = '';
                });
                showMessage('🔄 E31 Formular zurückgesetzt', 'info');
            }
        }

        function resetE32() {
            if (confirm('Möchten Sie alle E32-Daten wirklich löschen?')) {
                document.querySelectorAll('input[name^="e32_"], textarea[id^="e32_"]').forEach(el => {
                    if (el.type === 'radio' || el.type === 'checkbox') {
                        el.checked = false;
                    } else if (el.type === 'date' || el.type === 'time' || el.tagName === 'TEXTAREA') {
                        el.value = '';
                    }
                });
                fileStore['e32_01'] = [];
                fileStore['e32_02'] = [];
                fileStore['e32_03'] = [];
                fileStore['e32_04'] = [];
                document.querySelectorAll('[id$="_preview"]').forEach(div => {
                    if (div.id.startsWith('e32')) div.innerHTML = '';
                });
                showMessage('🔄 E32 Formular zurückgesetzt', 'info');
            }
        }

        function resetE33() {
            if (confirm('Möchten Sie alle E33-Daten wirklich löschen?')) {
                document.querySelectorAll('input[name^="e33_"], textarea[id^="e33_"]').forEach(el => {
                    if (el.type === 'radio' || el.type === 'checkbox') {
                        el.checked = false;
                    } else if (el.type === 'date' || el.type === 'time' || el.tagName === 'TEXTAREA') {
                        el.value = '';
                    }
                });
                fileStore['e33_01'] = [];
                fileStore['e33_02'] = [];
                fileStore['e33_03'] = [];
                fileStore['e33_04'] = [];
                document.querySelectorAll('[id$="_preview"]').forEach(div => {
                    if (div.id.startsWith('e33')) div.innerHTML = '';
                });
                showMessage('🔄 E33 Formular zurückgesetzt', 'info');
            }
        }

        function resetE34() {
            if (confirm('Möchten Sie alle E34-Daten wirklich löschen?')) {
                document.querySelectorAll('input[name^="e34_"], textarea[id^="e34_"]').forEach(el => {
                    if (el.type === 'radio' || el.type === 'checkbox') {
                        el.checked = false;
                    } else if (el.type === 'date' || el.type === 'time' || el.tagName === 'TEXTAREA') {
                        el.value = '';
                    }
                });
                fileStore['e34_01'] = [];
                fileStore['e34_02'] = [];
                fileStore['e34_03'] = [];
                fileStore['e34_04'] = [];
                document.querySelectorAll('[id$="_preview"]').forEach(div => {
                    if (div.id.startsWith('e34')) div.innerHTML = '';
                });
                showMessage('🔄 E34 Formular zurückgesetzt', 'info');
            }
        }

        // LocalStorage functions
        function saveToLocalStorage() {
            const data = {
                projectName: document.getElementById('projectName').value,
                projectArea: document.getElementById('projectArea').value
            };
            localStorage.setItem('projectInfo', JSON.stringify(data));
        }

        function loadFromLocalStorage() {
            const projectInfo = JSON.parse(localStorage.getItem('projectInfo'));
            if (projectInfo) {
                document.getElementById('projectName').value = projectInfo.projectName || '';
                document.getElementById('projectArea').value = projectInfo.projectArea || '';
            }
        }

        // Update Summary
        function updateSummary() {
            const checklistData = JSON.parse(localStorage.getItem('checklistData')) || {};
            let totalItems = 0;
            let compliantItems = 0;
            let nonCompliantItems = 0;
            let openItems = 0;

            Object.values(checklistData).forEach(module => {
                if (module.items) {
                    module.items.forEach(item => {
                        totalItems++;
                        if (item.status === 'compliant') {
                            compliantItems++;
                        } else if (item.status === 'non_compliant') {
                            nonCompliantItems++;
                        } else if (item.status === 'open') {
                            openItems++;
                        }
                    });
                }
            });

            document.getElementById('totalItems').textContent = totalItems;
            document.getElementById('compliantItems').textContent = compliantItems;
            document.getElementById('nonCompliantItems').textContent = nonCompliantItems;
            document.getElementById('openItems').textContent = openItems;
        }

        // Export functions
        function exportToJSON() {
            const data = {
                projectInfo: {
                    name: document.getElementById('projectName').value,
                    area: document.getElementById('projectArea').value,
                    exportDate: new Date().toISOString()
                },
                checklists: JSON.parse(localStorage.getItem('checklistData')) || {}
            };

            const dataStr = JSON.stringify(data, null, 2);
            downloadFile(dataStr, 'leitungsbau_checklisten_' + new Date().getTime() + '.json', 'application/json');
            showMessage('✅ JSON-Export erfolgreich!', 'success');
        }

        function exportToCSV() {
            const checklistData = JSON.parse(localStorage.getItem('checklistData')) || {};
            let csv = 'Projekt,Bereich,Modul,Item,Anwendbar,Status,Verantwortlich,Frist,Geprüft Am,Notizen\n';

            const projectName = document.getElementById('projectName').value;
            const projectArea = document.getElementById('projectArea').value;

            Object.entries(checklistData).forEach(([moduleId, module]) => {
                if (module.items) {
                    module.items.forEach(item => {
                        csv += `"${projectName}","${projectArea}","${moduleId}","${item.itemId}","${item.applicable}","${item.status}","${item.responsible}","${item.deadline}","${item.checkedDate}","${item.notes}"\n`;
                    });
                }
            });

            downloadFile(csv, 'leitungsbau_checklisten_' + new Date().getTime() + '.csv', 'text/csv');
            showMessage('✅ CSV-Export erfolgreich!', 'success');
        }

        function generatePDF() {
            showMessage('⚠️ PDF-Export wird generiert... Bitte warten!', 'warning');
            // Note: Für ein vollständiges PDF-Export würde eine Bibliothek wie jsPDF benötigt
            // Dies ist eine vereinfachte Version
            setTimeout(() => {
                window.print();
                showMessage('✅ PDF kann über den Browser-Druckdialog gespeichert werden!', 'success');
            }, 500);
        }

        function printReport() {
            window.print();
        }

        function downloadFile(content, filename, type) {
            const blob = new Blob([content], { type: type });
            const url = window.URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = filename;
            document.body.appendChild(a);
            a.click();
            window.URL.revokeObjectURL(url);
            document.body.removeChild(a);
        }

        function clearAllData() {
            if (confirm('⚠️ Alle Daten werden dauerhaft gelöscht. Fortfahren?')) {
                localStorage.clear();
                Object.keys(fileStore).forEach(key => delete fileStore[key]);
                document.getElementById('projectName').value = '';
                document.getElementById('projectArea').value = '';
                updateSummary();
                showMessage('🗑️ Alle Daten gelöscht!', 'warning');
                location.reload();
            }
        }

        function downloadBackup() {
            const backup = JSON.stringify({
                projectInfo: {
                    name: document.getElementById('projectName').value,
                    area: document.getElementById('projectArea').value
                },
                data: localStorage.getItem('checklistData')
            }, null, 2);

            downloadFile(backup, 'leitungsbau_backup_' + new Date().getTime() + '.json', 'application/json');
            showMessage('💾 Backup erfolgreich heruntergeladen!', 'success');
        }

        function showMessage(message, type) {
            const statusDiv = document.getElementById('statusMessage');
            statusDiv.innerHTML = `<div class="${type}-message">${message}</div>`;
            setTimeout(() => {
                statusDiv.innerHTML = '';
            }, 4000);
        }

        // Auto-save on input
        document.addEventListener('change', function() {
            saveToLocalStorage();
            updateSummary();
        });

        // Initialize
        window.addEventListener('load', initApp);
    </script>
</body>
</html>
